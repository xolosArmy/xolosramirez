{
  "name": "xolosramirez-site-audits",
  "private": true,
  "scripts": {
    "lint:html": "htmlhint \"**/*.html\" --ignore \"node_modules/**\"",
    "lint:links": "linkinator https://xolosramirez.com --recurse --silent",
    "test:lighthouse:home": "lighthouse https://xolosramirez.com --only-categories=performance,accessibility,best-practices,seo --preset=desktop --output=html --output-path=./reports/lighthouse-home.html",
    "test:lighthouse:available": "lighthouse https://xolosramirez.com/xolos-disponibles.html --only-categories=performance,accessibility,best-practices,seo --preset=desktop --output=html --output-path=./reports/lighthouse-available.html",
    "test:lighthouse:contact": "lighthouse https://xolosramirez.com/contacto.html --only-categories=performance,accessibility,best-practices,seo --preset=desktop --output=html --output-path=./reports/lighthouse-contact.html",
    "test:generate-lead": "node scripts/test-generate-lead-tracking.mjs",
    "test:webmcp": "node scripts/test-wm-xr1.mjs",
    "test:x402-xr0": "node tests/x402-xr0/harness.mjs",
    "test:x402-xr1": "node --test tests/x402-xr1/entitlement.test.mjs",
    "test:x402-xr1d": "node --test tests/x402-xr1d/schema.test.mjs tests/x402-xr1d/grant.test.mjs tests/x402-xr1d/authorize-access.test.mjs",
    "test:x402-xr1w": "node --test tests/x402-xr1w/controlled-e2e.test.mjs",
    "test": "node scripts/test-generate-lead-tracking.mjs && node --test scripts/test-journey.mjs && node scripts/test-wm-xr1.mjs && node tests/x402-xr0/harness.mjs && node --test tests/x402-xr1/entitlement.test.mjs && npm run test:x402-xr1d && npm run test:x402-xr1w"
  },
  "devDependencies": {
    "htmlhint": "^1.4.6",
    "linkinator": "^6.1.2",
    "lighthouse": "^12.2.0"
  }
}
