NODE_ENV=production

# Manual kill-switch. Must be true only during the reviewed binding ceremony.
XR1F_L1_BIND_ENABLED=false

# Exact deployed xolosramirez commit.
XR1F_L1_BUILD_SHA=replace-with-reviewed-deployment-sha

# Existing authoritative production C3B database. The ceremony never creates
# a fresh production DB; it may only add the reviewed XR1F-L1 binding schema.
XR1F_L1_C3B_DB_PATH=/srv/xolosramirez/xr1f/c3b.sqlite

# Watch-only merchant xpub and its SHA-256 fingerprint. This is public-key
# material, not signing authority, but should still be treated as operator config.
XR1F_L1_MERCHANT_XPUB=replace-with-mainnet-watch-only-xpub
XR1F_L1_MERCHANT_XPUB_SHA256=replace-with-sha256-of-trimmed-xpub

# Canonical x402-XEC anchor and locally built canonical core entrypoint.
XR1F_L1_X402_XEC_COMMIT=0f409dea2959b397ecc4bb84d71519ec6e3aec04
XR1F_L1_X402_MODULE_PATH=/opt/x402-xec/packages/x402-xec-core/dist/index.js
