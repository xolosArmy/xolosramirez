NODE_ENV=production
XR1F_RO_MODE=READ_ONLY

# Kill-switch. false => /ready always returns 503.
XR1F_RO_ENABLED=false

XR1F_RO_HOST=127.0.0.1
XR1F_RO_PORT=4021
XR1F_RO_BUILD_SHA=replace-with-deployed-git-sha

# Existing durable databases created by the canonical runtime.
# XR1F-RO opens both with node:sqlite readOnly=true.
XR1F_RO_C3B_DB_PATH=/srv/xolosramirez/xr1f/c3b.sqlite
XR1F_RO_XR1D_DB_PATH=/srv/xolosramirez/xr1f/xr1d.sqlite

# Server-owned Chronik endpoint. Read-only validation only.
XR1F_RO_CHRONIK_ENDPOINT=https://chronik.example.com
XR1F_RO_CHRONIK_PROBE_TXID=replace-with-known-public-mainnet-txid
XR1F_RO_CHRONIK_TIMEOUT_MS=4000

# Canonical x402-XEC source anchor and locally built provider artifact.
XR1F_RO_X402_XEC_COMMIT=0f409dea2959b397ecc4bb84d71519ec6e3aec04
XR1F_RO_PROVIDER_MODULE=/opt/x402-xec/real-chronik-tx-provider.js
XR1F_RO_PROVIDER_SHA256=replace-with-sha256-of-provider-artifact
